<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No QUERY_ALL_PACKAGES: the <queries> below give the launcher visibility of every launchable
        app, icon pack and widget provider, which is all it needs.
    -->
    <!-- Swipe-down gesture: expand the notification shade (normal permission). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" entry of the app context menu (opens the system confirmation dialog). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        "Copy original home screen layout": read access to other launchers' layouts. Most modern
        launchers keep these signature-only (then Android simply doesn't grant them and Flyer falls
        back to the launcher's built-in factory layout).
    -->
    <uses-permission android:name="com.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher3.permission.READ_SETTINGS" />
    <uses-permission android:name="com.google.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.sec.android.app.launcher.permission.READ_SETTINGS" />
    <!-- Unlocking the launcher lock with the phone's own fingerprint/face/PIN. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- ADW / Nova compatible icon packs -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <!-- Other home apps and partner layout packages (Copy original home screen layout). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="com.android.launcher3.action.PARTNER_CUSTOMIZATION" />
        </intent>
        <!-- App widget providers (receivers handling APPWIDGET_UPDATE). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".FlyerApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flyer.Launcher"
        tools:targetApi="36">

        <!--
            The one and only HOME activity. Flyer, the customization environment, is rendered
            inside this activity; it is NOT a separate activity, package or launcher.
        -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Lets the launcher be opened from the current launcher before it is made default. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles "Add to home screen" requests (pinned shortcuts and widgets) from other apps. -->
        <activity
            android:name=".launcher.PinItemActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.Flyer.Dialog">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>


        <!--
            Opt-in device admin used only to lock the phone when the lock button is held
            (policy: force-lock). Inactive until the user enables it from Flyer › Lock.
        -->
        <receiver
            android:name=".core.lock.FlyerDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
